      "grid": ["layoutRadius", "pathSides", "pathOrientation", "panelRotationMode", "panelRotationSpeed", "panelRotationTrigger", "panelMotionTarget", "panelTravelSpeed", "scrollSensitivity"]
    },
    "tiers": {
      "why": "PD-03: padding is a skin's artwork margin. The plain 2D surface draws no glow; 3D settings need the 3D renderer.",
      "procedural2d": [
