        "scene3DPositionY",
        "scene3DPositionZ",
        "scene3DQuality",
        "scene3DRoll",
        "scene3DScale",
        "scene3DThickness",
        "scene3DTransitions"
      ],
      "baked2.5d": [
        "appearance",
        "layoutPadding",
        "scene3DBand",
        "scene3DBend",
        "scene3DCameraPitch",
        "scene3DCameraYaw",
        "scene3DFieldOfView",
        "scene3DFillLight",
        "scene3DFloat",
        "scene3DIconElevation",
        "scene3DKeyLight",
