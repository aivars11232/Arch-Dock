  "homes": {
    "why": "OF-04, OF-07, OF-10, CF-04, CF-05, CF-14, PD-05, PD-08: rotation and opening and closing only on Animations, one icon style selector on Icons > Appearance.",
    "panelRotationMode": "1:9",
    "panelRotationSpeed": "1:9",
    "panelRotationTrigger": "1:9",
    "panelMotionTarget": "1:9",
    "panelTravelSpeed": "1:9",
    "scrollSensitivity": "1:9",
