    "collapseAxis": "1:9",
    "revealHandle": "1:9",
    "openDelay": "1:9",
    "closeDelay": "1:9",
    "iconStyle": "2:0"
  },
  "effects": {
    "about": [
      "frame: the panel drawn the applet's way (tests/TruthMatrixPanel.qml) differs after the change.",
      "hoverFrame: the same, with the pointer moved over the second icon: plain icons draw their tile under the pointer.",
      "runtime: the value the applet reads (panelRendererConfiguration) changes, and every consumer file still contains the line that reads it.",
      "placement: the edge placement the backend sends to Plasma (nativePanelPlacementStatus savedIntent) changes.",
      "visibility: the Plasma visibility mode the backend requests (nativePanelVisibilityStatus requestedMode) changes.",
      "conceal: whether the backend conceals the panel (shouldConcealPanel) changes.",
      "proof names the real-session test that shows the drawn result where this test cannot.",
      "needsShaders lists the renderer tiers on which the drawn effect comes from a shader. Qt Quick's software renderer (the offscreen run) draws no shaders; there the field is left to studio-truth-matrix-smoke, which draws with the real graphics backend and requires the change."
    ],
    "type": {
      "probe": "runtime",
      "value": "launcher",
      "consumers": [
        ["plasma-dock-widget/contents/ui/main.qml", "? String(configuration.type || \"empty\")"],
        ["src/panel/PanelWindowSettings.cpp", "dock.writeConfig('panelType', %3); dock.reloadConfig();"]
      ]
    },
    "screen": {"probe": "placement"},
    "edge": {"probe": "placement", "value": "top", "alternate": "bottom"},
    "alignment": {"probe": "placement"},
    "dynamic": {"probe": "placement"},
    "width": {"probe": "placement"},
    "height": {"probe": "placement"},
    "x": {
      "probe": "runtime",
      "source": "dock",
      "delta": 40,
      "consumers": [["src/panel/PanelWindowSettings.cpp", "draft.candidateFreeHostGeometry.insert(QStringLiteral(\"x\"), draft.candidatePanel.placement.x);"]],
      "proof": "runtime-ui-interaction-smoke: the owned desktop widget moves to the saved position"
    },
    "y": {
      "probe": "runtime",
      "source": "dock",
      "delta": 30,
      "consumers": [["src/panel/PanelWindowSettings.cpp", "draft.candidateFreeHostGeometry.insert(QStringLiteral(\"y\"), draft.candidatePanel.placement.y);"]],
      "proof": "runtime-ui-interaction-smoke: the owned desktop widget moves to the saved position"
    },
    "visible": {"probe": "conceal"},
    "visibilityMode": {"probe": "visibility"},
    "acceptDrops": {"probe": "runtime", "consumers": [["plasma-dock-widget/contents/ui/main.qml", "enabled: Boolean(root.configuration.acceptDrops) && !root.plasmaEditMode"]]},
    "folderLayout": {"probe": "runtime", "consumers": [["plasma-dock-widget/contents/ui/main.qml", "folderLayout: String(root.configuration.folderLayout || \"fan\")"]]},
    "folderSpeed": {"probe": "runtime", "consumers": [["plasma-dock-widget/contents/ui/main.qml", "folderSpeed: Number(root.configuration.folderSpeed || 260)"]]},
    "folderEasing": {"probe": "runtime", "consumers": [["plasma-dock-widget/contents/ui/main.qml", "folderEasing: String(root.configuration.folderEasing || \"outBack\")"]]},
    "folderShowNames": {"probe": "runtime", "consumers": [["plasma-dock-widget/contents/ui/main.qml", "showNames: root.configuration.folderShowNames !== false"]]},
    "folderExpandOnClick": {"probe": "runtime", "consumers": [["plasma-dock-widget/contents/ui/main.qml", "folderExpandOnClick: root.configuration.folderExpandOnClick !== false"]]},
    "showTooltips": {"probe": "runtime", "consumers": [["plasma-dock-widget/contents/ui/main.qml", "showTooltip: root.configuration.showTooltips"]]},
    "presentationMode": {
      "probe": "runtime",
      "consumers": [["plasma-dock-widget/contents/ui/main.qml", "restingState: String(root.configuration.presentationMode || \"open\")"]],
      "proof": "presentation-mechanism-smoke: every offered mechanism visibly collapses and reopens"
    },
    "presentationTrigger": {
      "probe": "runtime",
      "consumers": [["plasma-dock-widget/contents/ui/main.qml", "const value = String(configuration.presentationTrigger || \"hover\")"]],
      "proof": "runtime-ui-interaction-smoke: native hover opens and leaving closes the edge panel"
    },
    "collapseMechanism": {
      "probe": "runtime",
      "consumers": [["qml/ArchDock/Rendering/PanelScene.qml", "\"presentation\", \"collapseMechanism\", \"collapseMechanism\", \"open\"))"]],
      "proof": "presentation-mechanism-smoke: every offered mechanism visibly collapses and reopens"
    },
    "collapseAxis": {"probe": "runtime", "consumers": [["qml/ArchDock/Rendering/PanelScene.qml", "\"presentation\", \"collapseAxis\", \"collapseAxis\", \"\"))"]]},
    "revealHandle": {"probe": "runtime", "consumers": [["qml/ArchDock/Rendering/PanelScene.qml", "\"presentation\", \"revealHandle\", \"revealHandle\", \"edge-strip\")),"]]},
    "openDelay": {"probe": "runtime", "consumers": [["plasma-dock-widget/contents/ui/main.qml", "openDelay: Number(root.configuration.openDelay || 0)"]]},
    "closeDelay": {"probe": "runtime", "consumers": [["plasma-dock-widget/contents/ui/main.qml", "closeDelay: Number(root.configuration.closeDelay || 0)"]]},
    "panelRotationMode": {
      "probe": "runtime",
      "value": "clockwise",
      "alternate": "none",
      "consumers": [["qml/ArchDock/Rendering/PanelScene.qml", "\"layout\", \"rotationMode\", \"panelRotationMode\", \"none\"))"]],
      "proof": "runtime-ui-interaction-smoke: clockwise and counter-clockwise rotation turn the free panel"
    },
    "panelRotationSpeed": {"probe": "runtime", "consumers": [["qml/ArchDock/Rendering/PanelScene.qml", "\"layout\", \"rotationSpeed\", \"panelRotationSpeed\", 12))"]]},
    "panelRotationTrigger": {"probe": "runtime", "consumers": [["qml/ArchDock/Rendering/PanelScene.qml", "\"layout\", \"rotationTrigger\", \"panelRotationTrigger\", \"idle\"))"]]},
    "panelMotionTarget": {
      "probe": "runtime",
      "value": "both",
      "alternate": "items",
      "consumers": [["qml/ArchDock/Rendering/PanelScene.qml", "\"layout\", \"motionTarget\", \"panelMotionTarget\", \"items\")).trim().toLowerCase()"]],
      "proof": "path-travel-smoke: the wheel and continuous motion move the items, the whole panel or both"
    },
    "panelTravelSpeed": {"probe": "runtime", "consumers": [["qml/ArchDock/Rendering/PanelScene.qml", "\"layout\", \"travelSpeed\", \"panelTravelSpeed\", 0.5))"]]},
    "scrollSensitivity": {
      "probe": "runtime",
      "consumers": [["qml/ArchDock/Rendering/PanelScene.qml", "\"layout\", \"scrollSensitivity\", \"scrollSensitivity\", 1))"]],
      "proof": "tst_SceneRotation: test_wheelInputGathersIntoWholeSteps"
    },
