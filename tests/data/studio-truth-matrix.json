    {"id": "free-arc-true3d", "host": "free", "layout": "arc", "tier": "true3d", "theme": "arc-platform-orange"},
    {"id": "free-semicircle-procedural2d", "host": "free", "layout": "semicircle", "tier": "procedural2d", "theme": ""},
    {"id": "free-semicircle-baked2.5d", "host": "free", "layout": "semicircle", "tier": "baked2.5d", "theme": "arc-platform-orange"},
    {"id": "free-grid-procedural2d", "host": "free", "layout": "grid", "tier": "procedural2d", "theme": ""}
