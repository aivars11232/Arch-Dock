  "base": {
    "edge": {"type": "hybrid", "presentationMode": "open", "collapseMechanism": "collapse-horizontal"},
    "free": {"type": "hybrid", "panelRotationMode": "none", "layoutRadius": 150}
  },
  "forbidden": {
    "everywhere": {"why": "PD-04: no renderer draws Appearance > Shape.", "fields": ["shape"]},
    "edge": {
      "why": "An edge panel's applet lays its row out along its edge (plasma-dock-widget SceneDefinition.js); free placement, rotation and 3D belong to free panels.",
      "fields": [
        "x",
        "y",
        "layout",
        "layoutScale",
        "layoutPadding",
        "layoutAngle",
        "layoutRadius",
        "layoutRows",
        "pathOrientation",
        "pathSides",
        "panelRotationMode",
        "panelRotationSpeed",
        "panelRotationTrigger",
        "panelMotionTarget",
        "panelTravelSpeed",
        "scrollSensitivity",
