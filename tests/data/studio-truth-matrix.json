        "closeDelay",
        "showIndicators"
      ]
    },
    "layouts": {
      "why": "Radius, rows, sides and rotation act only on the layouts that draw from them (PD-08).",
      "horizontal": ["layoutRadius", "layoutRows", "pathSides", "panelRotationMode", "panelRotationSpeed", "panelRotationTrigger", "panelMotionTarget", "panelTravelSpeed", "scrollSensitivity"],
      "vertical": ["layoutRadius", "layoutRows", "pathSides", "panelRotationMode", "panelRotationSpeed", "panelRotationTrigger", "panelMotionTarget", "panelTravelSpeed", "scrollSensitivity"],
      "circular": ["layoutRows", "pathSides"],
      "ring": ["layoutRows", "pathSides"],
      "hexagon": ["layoutRows", "pathSides"],
      "star": ["layoutRows"],
      "fan": ["layoutRows", "pathSides"],
      "arc": ["layoutRows", "pathSides"],
