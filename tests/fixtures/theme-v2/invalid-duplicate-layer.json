{
  "format": "org.archdock.theme",
  "version": 2,
  "id": "fixture-duplicate-layer",
  "name": "Fixture Duplicate Layer",
  "capabilities": {
    "hosts": ["native-edge"],
    "rendererTiers": ["skinned2d", "procedural2d"],
    "preferredRendererTier": "skinned2d",
    "fallbackRendererTiers": ["procedural2d"],
    "layouts": ["horizontal"],
    "orientations": ["horizontal"],
    "features": [],
    "presentationMechanisms": [],
    "rotation": {"mode": "none"}
  },
  "assets": [
    {
      "id": "surface",
      "path": "assets/surface.svg",
      "kind": "vector",
      "naturalSize": {"width": 1200, "height": 160}
    }
  ],
  "states": [{"id": "normal", "layers": ["base"]}],
  "layers": [
    {
      "id": "base",
      "asset": "surface",
      "role": "surface",
      "opacity": 1.0,
      "blendMode": "source-over"
    },
    {
      "id": "base",
      "asset": "surface",
      "role": "glow",
      "opacity": 0.5,
      "blendMode": "screen"
    }
  ]
}
