{
  "format": "org.archdock.theme",
  "version": 2,
  "id": "fixture-baked-ring",
  "name": "Fixture Baked Ring",
  "capabilities": {
    "hosts": ["free-desktop"],
    "rendererTiers": ["baked2.5d", "procedural2d"],
    "preferredRendererTier": "baked2.5d",
    "fallbackRendererTiers": ["procedural2d"],
    "layouts": ["ring", "polygon"],
    "orientations": ["free"],
    "features": ["icon-state-styling"],
    "presentationMechanisms": [],
    "rotation": {"mode": "free"}
  },
  "assets": [
    {
      "id": "platform-rear",
      "path": "assets/platform-rear.svg",
      "kind": "vector",
      "mimeType": "image/svg+xml",
      "naturalSize": {"width": 1200, "height": 600}
    },
    {
      "id": "platform-front",
      "path": "assets/platform-front.svg",
      "kind": "vector",
      "mimeType": "image/svg+xml",
      "naturalSize": {"width": 1200, "height": 600}
    },
    {
      "id": "input-mask",
      "path": "assets/ring-input.svg",
      "kind": "mask",
      "mimeType": "image/svg+xml",
      "naturalSize": {"width": 1200, "height": 600}
    }
  ],
  "states": [{"id": "normal", "layers": ["rear-layer", "front-layer"]}],
  "layers": [
    {
      "id": "rear-layer",
      "asset": "platform-rear",
      "role": "rear",
      "sourceRect": {"x": 0, "y": 0, "width": 1200, "height": 600},
      "opacity": 1.0,
      "blendMode": "source-over"
    },
    {
      "id": "front-layer",
      "asset": "platform-front",
      "role": "foreground",
      "sourceRect": {"x": 0, "y": 0, "width": 1200, "height": 600},
      "opacity": 1.0,
      "blendMode": "source-over"
    }
  ],
  "contentRegions": [
    {
      "id": "ring-content",
      "state": "normal",
      "orientation": "free",
      "shape": "rect",
      "rect": {"x": 80, "y": 110, "width": 1040, "height": 380}
    }
  ],
  "tracks": [
    {
      "id": "ring-track",
      "state": "normal",
      "shape": "ellipse",
      "center": {"x": 600, "y": 300},
      "radiusX": 450,
      "radiusY": 160,
      "startDegrees": 0,
      "depth": {"farScale": 0.62, "nearScale": 1.0, "occlusionDepth": 0.5},
      "tilt": {"minimumDegrees": -12, "maximumDegrees": 12, "defaultDegrees": 0}
    }
  ],
  "inputMasks": [
    {
      "id": "normal-input",
      "asset": "input-mask",
      "state": "normal",
      "orientation": "free",
      "threshold": 0.5
    }
  ]
}
