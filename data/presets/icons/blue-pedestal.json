{
  "format": "org.archdock.icon-preset",
  "schemaVersion": 1,
  "identity": {
    "id": "blue-pedestal",
    "name": "Blue Pedestal",
    "description": "A blue glass orb standing on a lit blue pedestal around the application's own icon.",
    "builtIn": true,
    "revision": 1
  },
  "compatibility": {
    "rendererTiers": ["procedural2d"],
    "requiredStyleCapabilities": ["tile", "reflection", "shadow", "glow"],
    "reducedMotionSupport": true
  },
  "icon": {
    "iconStyleId": "dark-orb",
    "visualOverrides": {
      "orb-shadow": {"borderColor": "#24384f"},
      "orb-pedestal": {"color": "#07101d", "secondaryColor": "#27476b", "borderColor": "#3d9bff", "opacity": 1, "borderWidth": 0.03},
      "orb-glass": {"color": "#06101c", "secondaryColor": "#1b3350", "borderColor": "#5fb0ff"},
      "orb-energy-ring": {"secondaryColor": "#cfe6ff", "borderColor": "#7cc0ff"},
      "orb-reflection": {"color": "#cfe6ff"},
      "orb-glow": {"color": "#3d9bff", "borderColor": "#3d9bff"}
    },
    "stateOverrides": {
      "normal": {"borderColor": "#5fb0ff", "glowColor": "#3d9bff", "indicatorColor": "#7cc0ff"},
      "hover": {"borderColor": "#cfe6ff", "glowColor": "#7cc0ff", "indicatorColor": "#a8d4ff"},
      "pressed": {"borderColor": "#5fb0ff", "glowColor": "#2f7fd6", "indicatorColor": "#7cc0ff"},
      "active": {"borderColor": "#cfe6ff", "glowColor": "#7cc0ff", "indicatorColor": "#cfe6ff"},
      "running": {"borderColor": "#7cc0ff", "glowColor": "#3d9bff", "indicatorColor": "#7cc0ff"},
      "minimized": {"borderColor": "#3a5672", "glowColor": "#3a5672", "indicatorColor": "#5c7a96"},
      "launching": {"borderColor": "#a8d4ff", "glowColor": "#7cc0ff", "indicatorColor": "#a8d4ff"}
    },
    "glyphPolicy": {"mode": "original", "compatibleOnly": true},
    "motion": {
      "profileId": "glow",
      "animationTrigger": "hover",
      "animationSpeed": 1.0,
      "animationIntensity": 1.0,
      "magnificationRadius": 2.4,
      "magnificationFalloff": "linear"
    },
    "perStateAnimationOverrides": {}
  },
  "fallback": {"iconStyleId": "plain-original", "motionProfileId": "none"}
}
