{
  "format": "org.archdock.panel-preset",
  "schemaVersion": 1,
  "identity": {
    "id": "octagonal-platform",
    "name": "Octagonal Platform",
    "description": "A free-standing steel octagon platform on the desktop with dark orb icons on its eight sides.",
    "builtIn": true,
    "revision": 1
  },
  "preview": {
    "previewMode": "free",
    "rendererTier": "baked2.5d",
    "fallbackTier": "procedural2d",
    "deterministicPreviewSeed": "octagonal-platform-v1"
  },
  "compatibility": {
    "hostKinds": ["free-desktop"],
    "orientations": ["free"],
    "layouts": ["octagon", "polygon"],
    "requiredCapabilities": [],
    "optionalCapabilities": ["baked2.5d", "dynamic-tint", "dynamic-glow"]
  },
  "panel": {
    "host": {"edge": "free"},
    "content": {"type": "launcher"},
    "placement": {"alignment": "center", "dynamic": false, "width": 420, "height": 420},
    "visibility": {"visibilityMode": "always"},
    "presentation": {
      "presentationMode": "open",
      "presentationTrigger": "hover",
      "collapseMechanism": "open",
      "collapseAxis": "horizontal",
      "revealHandle": "edge-strip"
    },
    "layout": {
      "layout": "octagon",
      "layoutScale": 1.0,
      "layoutRadius": 300,
      "layoutPadding": 18,
      "pathSides": 8,
      "pathOrientation": "upright",
      "iconShape": "circle",
      "iconSize": 52,
      "spacing": 10
    },
    "theme": {"completeThemeId": "octagon-platform-steel", "rendererTier": "baked2.5d"},
    "surface": {"appearance": "glass", "shape": "pill", "opacity": 0.9, "color": "#9fb0be", "glowIntensity": 1.1},
    "motion": {
      "iconAnimation": "glow",
      "animationTrigger": "hover",
      "animationSpeed": 0.9,
      "animationIntensity": 0.9,
      "magnificationRadius": 2.4,
      "magnificationFalloff": "linear"
    },
    "recommendedIconPresetId": "dark-orb"
  },
  "fallback": {
    "themeId": "",
    "iconPresetId": "original-clean",
    "unsupportedFieldPolicy": "reject"
  }
}
