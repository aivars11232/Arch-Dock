{
  "format": "org.archdock.panel-preset",
  "schemaVersion": 1,
  "identity": {
    "id": "holographic-semicircle",
    "name": "Holographic Semicircle",
    "description": "A free-standing teal holographic half circle on the desktop with holographic icon tiles.",
    "builtIn": true,
    "revision": 1
  },
  "preview": {
    "previewMode": "free",
    "rendererTier": "procedural2d",
    "fallbackTier": "procedural2d",
    "deterministicPreviewSeed": "holographic-semicircle-v1"
  },
  "compatibility": {
    "hostKinds": ["free-desktop"],
    "orientations": ["free"],
    "layouts": ["semicircle", "arc"],
    "requiredCapabilities": [],
    "optionalCapabilities": ["dynamic-tint"]
  },
  "panel": {
    "host": {"edge": "free"},
    "content": {"type": "launcher"},
    "placement": {"alignment": "center", "dynamic": false, "width": 420, "height": 420},
    "visibility": {"visibilityMode": "always"},
    "presentation": {
      "presentationMode": "open",
      "presentationTrigger": "hover",
      "collapseMechanism": "open",
      "collapseAxis": "horizontal",
      "revealHandle": "edge-strip"
    },
    "layout": {
      "layout": "semicircle",
      "layoutScale": 1.0,
      "layoutRadius": 220,
      "layoutPadding": 18,
      "pathOrientation": "upright",
      "iconShape": "circle",
      "iconSize": 48,
      "spacing": 10
    },
    "theme": {"completeThemeId": ""},
    "surface": {"appearance": "futuristic", "shape": "hexagon", "opacity": 0.9, "color": "#082a35", "glowIntensity": 1.0},
    "motion": {
      "iconAnimation": "glow",
      "animationTrigger": "hover",
      "animationSpeed": 0.8,
      "animationIntensity": 0.8,
      "magnificationRadius": 2.4,
      "magnificationFalloff": "linear"
    },
    "recommendedIconPresetId": "holographic-tile"
  },
  "fallback": {
    "themeId": "",
    "iconPresetId": "original-clean",
    "unsupportedFieldPolicy": "reject"
  }
}
