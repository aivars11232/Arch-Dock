{
  "format": "org.archdock.panel-preset",
  "schemaVersion": 1,
  "identity": {
    "id": "metallic-shelf-dock",
    "name": "Metallic Shelf Dock",
    "description": "A brushed metal shelf dock for a screen edge, drawn procedurally with metallic blue icon tiles.",
    "builtIn": true,
    "revision": 1
  },
  "preview": {
    "previewMode": "horizontal",
    "rendererTier": "procedural2d",
    "fallbackTier": "procedural2d",
    "deterministicPreviewSeed": "metallic-shelf-dock-v1"
  },
  "compatibility": {
    "hostKinds": ["native-edge", "free-desktop"],
    "orientations": ["horizontal"],
    "layouts": ["horizontal"],
    "requiredCapabilities": [],
    "optionalCapabilities": ["dynamic-tint"]
  },
  "panel": {
    "host": {"edge": "bottom"},
    "content": {"type": "hybrid"},
    "placement": {"alignment": "center", "dynamic": false, "width": 760, "height": 80},
    "visibility": {"visibilityMode": "always"},
    "presentation": {
      "presentationMode": "open",
      "presentationTrigger": "hover",
      "collapseMechanism": "open",
      "collapseAxis": "horizontal",
      "revealHandle": "edge-strip"
    },
    "layout": {
      "layout": "horizontal",
      "layoutScale": 1.0,
      "layoutPadding": 18,
      "iconShape": "rounded",
      "iconSize": 54,
      "spacing": 7
    },
    "theme": {"completeThemeId": "metallic-shelf"},
    "surface": {"appearance": "metallic", "shape": "pill", "opacity": 0.96, "color": "#3a414b", "glowIntensity": 1.0},
    "motion": {
      "iconAnimation": "pulse",
      "animationTrigger": "hover",
      "animationSpeed": 0.9,
      "animationIntensity": 0.8,
      "magnificationRadius": 2.4,
      "magnificationFalloff": "linear"
    },
    "recommendedIconPresetId": "metallic-blue"
  },
  "fallback": {
    "themeId": "metallic-shelf",
    "iconPresetId": "original-clean",
    "unsupportedFieldPolicy": "reject"
  }
}
