[Desktop Entry]
Type=Application
Name=Arch Dock
Comment=Glass application dock for KDE Plasma
Exec=@ARCHDOCK_DESKTOP_EXEC@ --settings
Icon=org.archdock.ArchDock
Terminal=false
Categories=Utility;System;
StartupNotify=false
StartupWMClass=arch-dock
Actions=Quit;

[Desktop Action Quit]
Name=Quit Arch Dock
Exec=@ARCHDOCK_DESKTOP_EXEC@ --quit
